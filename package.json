{
  "name": "sliper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "check": "npm run security:secrets && npm run format:check && npm run typecheck && npm test && npm run db:check",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 setup && tsx scripts/local-bootstrap.ts && npm run db:migrate && npm run db:seed && npm run db:seed:demo",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 start",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 stop",
    "db:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 status",
    "test:api": "tsx --test tests/api.integration.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "format": "prettier --write src scripts/**/*.ts tests *.ts *.json",
    "format:check": "prettier --check src scripts/**/*.ts tests *.ts *.json",
    "test:payments": "tsx --test tests/payments.integration.ts",
    "test:features": "tsx --test tests/playbook-api.integration.ts",
    "test:lightning": "tsx --test tests/lightning-api.integration.ts",
    "dev:lan": "tsx scripts/dev-lan.ts",
    "push:setup": "tsx scripts/push-setup.ts",
    "push:worker": "tsx scripts/push-worker.ts",
    "push:drain": "tsx scripts/push-worker.ts --once",
    "test:push-api": "tsx --test tests/push-api.integration.ts",
    "auth:test:setup": "tsx scripts/test-account-setup.ts",
    "test:auth-api": "tsx --test tests/test-auth-api.integration.ts",
    "test:application-forms": "tsx --test tests/application-profile-api.integration.ts",
    "test:room-members-api": "tsx --test tests/room-members-api.integration.ts",
    "test:event-map-api": "tsx --test tests/event-map-api.integration.ts",
    "staff:local": "tsx scripts/staff.ts --local-admin",
    "staff:grant": "tsx scripts/staff.ts",
    "test:safety-api": "tsx --test tests/safety-api.integration.ts",
    "test:event-operations-api": "tsx --test tests/event-operations-api.integration.ts",
    "test:event-lifecycle-api": "tsx --test tests/event-lifecycle-api.integration.ts",
    "test:engagement-api": "tsx --test tests/engagement-api.integration.ts",
    "test:rich-post-api": "tsx --test tests/rich-post-api.integration.ts",
    "test:search-api": "tsx --test tests/search-api.integration.ts",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "test:crew-api": "tsx --test tests/crew-api.integration.ts",
    "test:crew-concurrency": "tsx --test tests/crew-concurrency.integration.ts",
    "test:video-api": "tsx --test tests/video-api.integration.ts",
    "video:worker": "tsx scripts/video-worker.ts",
    "video:drain": "tsx scripts/video-worker.ts --once",
    "test:room-realtime": "tsx --test tests/room-realtime.integration.ts",
    "redis:local:start": "docker compose up -d redis",
    "redis:local:stop": "docker compose stop redis",
    "postbuild": "tsx scripts/verify-server-traces.ts",
    "test:records": "node --conditions=react-server --import tsx --test tests/records.integration.ts",
    "test:knowledge": "node --conditions=react-server --import tsx --test tests/knowledge-reuse.integration.ts",
    "test:knowledge-api": "tsx --test tests/knowledge-api.integration.ts",
    "test:places": "node --conditions=react-server --import tsx --test tests/place-history.integration.ts",
    "test:places-api": "node --conditions=react-server --import tsx --test tests/place-history-api.integration.ts",
    "test:collaboration": "node --conditions=react-server --import tsx --test tests/library-collaboration.integration.ts",
    "test:collaboration-api": "node --conditions=react-server --import tsx --test tests/library-collaboration-api.integration.ts",
    "test:market": "node --conditions=react-server --import tsx --test tests/library-market.integration.ts",
    "test:market-api": "node --conditions=react-server --import tsx --test tests/library-market-api.integration.ts",
    "security:secrets": "tsx scripts/check-secrets.ts",
    "security:staged": "tsx scripts/check-secrets.ts --staged",
    "test:discovery-api": "tsx --test tests/discovery-api.integration.ts",
    "test:aftercare-api": "tsx --test tests/event-aftercare-api.integration.ts",
    "test:operations-api": "tsx --test tests/operations-api.integration.ts",
    "media:cleanup": "node --conditions=react-server --import tsx scripts/media-cleanup.ts",
    "backup:local": "tsx scripts/local-backup.ts",
    "backup:verify": "tsx scripts/local-restore-verify.ts",
    "test:f2-api": "tsx --test tests/f2-api.integration.ts",
    "test:media-retention": "node --conditions=react-server --import tsx --test tests/media-retention.integration.ts",
    "test:adsense-api": "tsx --test tests/adsense-api.integration.ts",
    "test:readiness-api": "tsx --test tests/release-readiness-api.integration.ts",
    "deploy:db-check": "node --import tsx scripts/deploy-db-check.ts --",
    "test:event-contact-api": "tsx --test tests/event-contact-api.integration.ts"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@next/env": "16.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.4",
    "drizzle-orm": "0.45.3",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "redis": "6.3.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
