[Unit]
Description=Sliper web on independent port 13000
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=sliper
Group=sliper
WorkingDirectory=/opt/sliper/current/standalone
EnvironmentFile=/etc/sliper/runtime.env
Environment=NODE_ENV=production
Environment=PATH=/opt/sliper/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TMPDIR=/run/sliper-web
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=0.0.0.0
Environment=PORT=13000
Environment=PUSH_WORKER_MODE=external
ExecStart=/opt/sliper/runtime/node/bin/node /opt/sliper/current/standalone/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
RuntimeDirectory=sliper-web
RuntimeDirectoryMode=0700
StateDirectory=sliper
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sliper /run/sliper-web
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
LimitNOFILE=65536
MemoryMax=1G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sliper-web

[Install]
WantedBy=multi-user.target
