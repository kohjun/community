[Unit]
Description=Sliper Town Colyseus world on loopback 13003
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
[Service]
Type=exec
User=sliper
Group=sliper
WorkingDirectory=/opt/sliper/current/worker
EnvironmentFile=/etc/sliper/runtime.env
EnvironmentFile=/etc/sliper/domain.env
EnvironmentFile=/etc/sliper/seoul.env
EnvironmentFile=/etc/sliper/town.env
Environment=NODE_ENV=production
Environment=PATH=/opt/sliper/runtime/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=LOCAL_DATABASE=0
Environment=SLIPER_CLOUD_ONLY=true
Environment=SLIPER_AUTH_MODE=supabase
ExecStart=/opt/sliper/runtime/node/bin/node --import tsx scripts/town-server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=75%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sliper-town
[Install]
WantedBy=multi-user.target
