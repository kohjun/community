[Unit]
Description=Sliper single-job video worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=sliper
Group=sliper
WorkingDirectory=/opt/sliper/current/worker
EnvironmentFile=/etc/sliper/runtime.env
Environment=NODE_ENV=production
Environment=PATH=/opt/sliper/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TMPDIR=/run/sliper-video
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/sliper/runtime/node/bin/node --import tsx /opt/sliper/current/worker/scripts/video-worker.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=300s
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
RuntimeDirectory=sliper-video
RuntimeDirectoryMode=0700
StateDirectory=sliper
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sliper /run/sliper-video
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=100%
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sliper-video

[Install]
WantedBy=multi-user.target
