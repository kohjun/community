[Unit]
Description=Sliper game drawing gateway on private loopback
After=network-online.target sliper-game-redis.service
Wants=network-online.target sliper-game-redis.service
[Service]
Type=exec
User=sliper
Group=sliper
WorkingDirectory=/opt/sliper/current/worker
EnvironmentFile=/etc/sliper/runtime.env
EnvironmentFile=/etc/sliper/domain.env
EnvironmentFile=/etc/sliper/seoul.env
EnvironmentFile=/etc/sliper/town.env
EnvironmentFile=/etc/sliper/game-ink.env
Environment=NODE_ENV=production
Environment=GAME_INK_PORT=13004
ExecStart=/opt/sliper/runtime/node/bin/node --import tsx scripts/game-ink-server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=50%
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
