[Unit]
Description=Sliper service, worker progress, certificate and resource health probe
After=network-online.target

[Service]
Type=oneshot
User=root
Group=sliper-monitor
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /opt/sliper/ops/sliper-monitor.py probe
TimeoutStartSec=40s
UMask=0027
StateDirectory=sliper-monitor
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sliper-monitor
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryMax=128M
CPUQuota=20%
StandardOutput=journal
StandardError=journal
