# Local development: add to ignored .env; production: /etc/sliper/town.env
# Generate a random secret of at least 48 characters; never use a public API key.
TOWN_SIGNING_SECRET=
TOWN_PORT=13003
TOWN_MAX_CLIENTS=8
# Town-only cache; do not change the community announcement transport.
TOWN_REDIS_URL=
# Reuse existing DATABASE_URL, APP_ORIGIN and an optional development REDIS_URL from the normal runtime environment.
# Optional LiveKit. Leave blank until your SFU or Cloud project is ready.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Enable ONLY after a real SFU test proves server-selected subscriptions work
# with canSubscribe=false AND a modified client cannot subscribe to arbitrary tracks.
TOWN_VOICE_SERVER_SUBSCRIPTIONS_VERIFIED=false
