# Backup-only preflight. Copy to .env.backup (ignored by Git/Docker), mode 0600.
# NEVER include this file in web/worker compose env_file or image build arguments.
# This command checks readiness only; it does not create a backup or perform a restore.
# node --import tsx scripts/cloud-backup-preflight.ts --env-file .env.backup

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=sliper-private-images
SUPABASE_STORAGE_SECRET_KEY=

# Runtime SELECT connection for aggregate metadata inventory; TLS is mandatory.
# Existing transaction-mode pooler (6543) may be used for this read-only inventory.
DATABASE_URL=

# Backup-only direct or session-mode pooler (5432) connection on the SOURCE project.
# Use the Supabase Connect dialog: direct or session-mode pooler, TLS enabled.
# Do not copy privileged backup credentials into the application environment.
# Actual dump and Auth schema permissions remain to be verified during a backup rehearsal.
BACKUP_DATABASE_URL=

# A NEW, EMPTY, DIFFERENT Supabase project for a future restore rehearsal.
# Same-project aliases are rejected. Existing Sliper tables or Auth users are refused.
# No target reset/clean/drop/restore command exists in this preflight.
BACKUP_RESTORE_PROJECT_URL=
BACKUP_RESTORE_DATABASE_URL=

# Native PostgreSQL client directory: tools must support the source server version.
# Linux deployment default; on Windows use C:/Program Files/PostgreSQL/18/bin.
POSTGRES_BIN=/usr/bin

# Encrypted capture: npm run cloud:backup -- --env-file PATH
# Local isolated logical drill: npm run cloud:restore:drill -- --backup backup_DATE_ID
# The local drill creates its own loopback cluster; these remote restore fields are
# readiness checks for a separate future Supabase managed-service rehearsal.
# See docs/OPERATIONS_BACKUP_MONITORING_2026-10-27.md for scope and remaining checks.
