# Copy to .env.production (ignored by Git and Docker). Populate in hosting secrets.
# A public HTTPS domain is required before real OAuth/push deployment.
# HTTPS proxy settings: hostname only + certificate contact. Use after DNS is configured.
SLIPER_DOMAIN=your-domain.example
ACME_EMAIL=
APP_ORIGIN=https://your-domain.example
# Keep the same release tag for web and both workers; retain the previous tag for rollback.
SLIPER_RELEASE=20261026-01
# Default loopback. For explicit direct access use 0.0.0.0 plus an unused public port (e.g. 13000).
# HTTP IP:port preview does not enable production OAuth/push; configure Sliper HTTPS separately.
SLIPER_BIND_ADDRESS=127.0.0.1
SLIPER_BIND_PORT=3000
SLIPER_CLOUD_ONLY=true
SLIPER_AUTH_MODE=supabase
LOCAL_DATABASE=0
SLIPER_LAN_HOST=
# Use the restricted application role, never postgres/owner. URL-encode the password.
DATABASE_URL=
# Do not put migration-owner credentials in web/worker environments.
MIGRATION_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
MEDIA_STORAGE_BACKEND=supabase
SUPABASE_STORAGE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=sliper-private-images
SUPABASE_STORAGE_SECRET_KEY=
# The realtime server uses the storage server secret on the same Supabase project by default.
# Optional separate server secret; never NEXT_PUBLIC_.
SUPABASE_REALTIME_SECRET_KEY=
ROOM_REALTIME_PROVIDER=supabase
REDIS_URL=
VISITOR_HASH_SECRET=
PUSH_WORKER_MODE=external
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_NAVER_MAP_KEY_ID=
SLIPER_ADSENSE_ENABLED=false
SLIPER_ADSENSE_CLIENT_ID=
SLIPER_ADSENSE_SLOT_INLINE=
SLIPER_ADSENSE_SLOT_LEFT=
SLIPER_ADSENSE_SLOT_RIGHT=
# Payment integrations are optional until a provider is chosen; keep manual approval available.
PAYMENT_PROVIDER=
PAYMENT_CHECKOUT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CHECKOUT_ORIGINS=
EXTERNAL_APPROVAL_PROVIDER=
EXTERNAL_APPROVAL_WEBHOOK_SECRET=
LIBRARY_PAYMENT_PROVIDER=
LIBRARY_PAYMENT_WEBHOOK_SECRET=

# Public operator/contact details; these are displayed to visitors. Never put secrets here.
SLIPER_OPERATOR_NAME="Team sliper"
SLIPER_SUPPORT_EMAIL=kohjun1234@gmail.com
SLIPER_BUSINESS_NAME=
SLIPER_BUSINESS_REPRESENTATIVE=
SLIPER_BUSINESS_REGISTRATION_NUMBER=
SLIPER_BUSINESS_ADDRESS=
SLIPER_ECOMMERCE_REGISTRATION=
# Set true only after actual retention/processor conditions are reviewed.
SLIPER_PRIVACY_POLICY_REVIEWED=false
# Public production HTTPS only. Development and private pages remain noindex.
SLIPER_SEARCH_INDEXING_ENABLED=false
