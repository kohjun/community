FROM node:24-bookworm-slim
WORKDIR /app
# tsx runs the TypeScript entrypoint; native FFmpeg is installed here rather than in a web trace.
COPY package.json package-lock.json ./
# FFprobe's package grants execute only to its installer; the worker runs as node.
RUN npm ci --include=dev --no-audit --no-fund \
    && node -e "require('node:fs').chmodSync(require('@ffprobe-installer/ffprobe').path, 0o755)" \
    && npm cache clean --force
COPY tsconfig.json ./
COPY src ./src
COPY scripts/video-worker.ts ./scripts/video-worker.ts
COPY scripts/worker-health.ts ./scripts/worker-health.ts
ENV NODE_ENV=production SLIPER_CLOUD_ONLY=true SLIPER_AUTH_MODE=supabase LOCAL_DATABASE=0 MEDIA_STORAGE_BACKEND=supabase
USER node
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["node", "--import", "tsx", "scripts/worker-health.ts", "video"]
CMD ["./node_modules/.bin/tsx", "scripts/video-worker.ts"]
