# Server only. Supabase PostgreSQL pooler connection for the Next.js server.
DATABASE_URL=
# Direct or session-pooler connection, using the schema owner, for migrations/seed.
MIGRATION_DATABASE_URL=

# Supabase project URL and public publishable key. See docs/COMMUNITY_FOUNDATION.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only random secret (at least 32 characters); keep stable across replicas.
# Used to hash the signed browser visitor identifier. Never send it to the client.
VISITOR_HASH_SECRET=

# Production OAuth: SLIPER_AUTH_MODE=supabase, LOCAL_DATABASE=0, HTTPS APP_ORIGIN.
# Local setup selects development mode automatically; never use it for production.
SLIPER_AUTH_MODE=disabled
LOCAL_DATABASE=0
APP_ORIGIN=http://127.0.0.1:3000
# Optional exact private IPv4 address of this development PC (no scheme/port).
# Allows password-based test sessions only at this LAN host:3000; never a fixed actor.
# HTTP LAN still cannot subscribe to Web Push. Leave empty to disable LAN test login.
SLIPER_LAN_HOST=

# Image storage driver. local preserves existing .local files; supabase requires a private bucket.
# Rows remember their backend; changing this setting does not copy existing local files.
MEDIA_STORAGE_BACKEND=local
# HTTPS project origin without port/path/query. Never use NEXT_PUBLIC_ for the secret key.
SUPABASE_STORAGE_URL=
# Server-only sb_secret_ or legacy service_role key; separate from Auth publishable key.
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional external payment bridge. Empty = disconnected; never use NEXT_PUBLIC_ keys.
# Provider-specific API/signature formats require a server adapter (docs/PARTICIPATION.md).
PAYMENT_PROVIDER=
PAYMENT_CHECKOUT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Comma-separated exact HTTPS origins returned by the checkout bridge.
PAYMENT_CHECKOUT_ORIGINS=

# External platform registrations: signed confirmation only, no checkout API required.
EXTERNAL_APPROVAL_PROVIDER=
EXTERNAL_APPROVAL_WEBHOOK_SECRET=

# Dedicated signed library purchase/refund bridge. Leave empty for seller manual approval.
# Separate from event payment secrets. Bridge must map purchaseId to its verified buyer/transaction.
LIBRARY_PAYMENT_PROVIDER=
LIBRARY_PAYMENT_WEBHOOK_SECRET=

# Standard Web Push / VAPID: server-only credentials, stable across worker replicas.
# Local development: npm run push:setup creates ignored .local/push-vapid.json.
# Production: generate an EC key pair, supply a real contact URI and run push:worker.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Runs durable inbox/subscriptions/reminders even without VAPID; VAPID enables phone delivery.
# external = dedicated worker (production default); embedded = always-on Next server.
PUSH_WORKER_MODE=external

# NAVER Cloud Maps > Application > Key ID (browser SDK public identifier).
# Enable Dynamic Map and Geocoding, and register each host without port/path.
# No Client Secret is required by the browser map SDK.
NEXT_PUBLIC_NAVER_MAP_KEY_ID=

# Optional server-only announcement room Pub/Sub. Messages remain in PostgreSQL.
# Local Docker: redis://127.0.0.1:6380; production: private authenticated rediss://.
# Empty/unreachable = DB polling fallback; never use NEXT_PUBLIC_ for Redis.
REDIS_URL=
